Bootstrap: docker
From: mambaorg/micromamba:2.3.0

%files
    ../../environment.yml /environment.yml

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends \
        libice6 \
        libsm6 \
        libx11-6 \
        libxext6 \
        libxmu6 \
        libxrender1 \
        libxt6 \
        procps
    rm -rf /var/lib/apt/lists/*
    micromamba env create -y -f /environment.yml
    micromamba clean -a -y

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export CONDA_PREFIX=/opt/conda/envs/decon_env
    export CONDA_DEFAULT_ENV=decon_env
    export PATH=/opt/conda/envs/decon_env/bin:/opt/conda/bin:$PATH
    export PYTHONNOUSERSITE=1

%runscript
    exec "$@"

%labels
    Author deconvolution-gpu
    Environment environment.yml
