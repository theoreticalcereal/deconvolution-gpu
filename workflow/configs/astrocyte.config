/*
 * Astrocyte entry-point config.
 *
 * Astrocyte reads the config named by astrocyte_pkg.yml. Include the standard
 * workflow config, then enable Singularity and build the DECON image from its
 * definition before DECON runs. Users do not need to understand Git LFS or
 * build the container manually.
 */

includeConfig 'nextflow.config'

singularity.enabled = true
conda.enabled = false

params.build_decon_container = true

profiles {
    light_sheet {
        conda.enabled = false
        singularity.enabled = true
    }

    wide_frame {
        conda.enabled = false
        singularity.enabled = true
    }

    light_sheet_decon {
        conda.enabled = false
        singularity.enabled = true
    }
}
