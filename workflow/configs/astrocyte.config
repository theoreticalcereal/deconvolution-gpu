/*
 * Astrocyte entry-point config.
 *
 * Astrocyte reads the config named by astrocyte_pkg.yml. Include the standard
 * workflow config, then enable Singularity for BioHPC/Astrocyte runs.
 */

includeConfig 'nextflow.config'

singularity {
    enabled = true
    cacheDir = "$baseDir/images/singularity"
}

conda.enabled = false

params.build_decon_container = false

profiles {
    light_sheet {
        conda.enabled = false
        singularity.enabled = true
    }

    wide_frame {
        conda.enabled = false
        singularity.enabled = true
    }

    light_sheet_decon {
        conda.enabled = false
        singularity.enabled = true
    }
}

trace.overwrite = true
timeline.overwrite = true
report.overwrite = true
dag.overwrite = true
