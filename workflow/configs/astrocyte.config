/*
 * Astrocyte entry-point config.
 *
 * Astrocyte reads the config named by astrocyte_pkg.yml. Include the standard
 * workflow config, then build the decon conda runtime before DECON.
 */

includeConfig 'nextflow.config'

conda.enabled = false

params.build_decon_container = true

profiles {
    light_sheet {
        conda.enabled = false
    }

    wide_frame {
        conda.enabled = false
    }

    light_sheet_decon {
        conda.enabled = false
    }
}

trace.overwrite = true
timeline.overwrite = true
report.overwrite = true
dag.overwrite = true
