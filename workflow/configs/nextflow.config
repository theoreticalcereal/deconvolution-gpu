def mcrroot = System.getenv('MCRROOT')
def defaultMatlabRoot = '/home1/apps/MATLAB/R2024a'
def matlabRoot = mcrroot ? new File(mcrroot).parent : (new File(defaultMatlabRoot).exists() ? defaultMatlabRoot : null)
def matlabBin = matlabRoot ? "${matlabRoot}/bin/matlab" : 'matlab'

params {
    // Astrocyte file picker input. When supplied, these TIFFs are staged into
    // the directory layout expected by the existing deskew/decon scripts.
    image_files = []
    // Backward-compatible alias for manual or older Astrocyte runs.
    input       = []
    // Backward-compatible raw input parent directory for manual CLI runs.
    image_path  = ''
    // Input directory basename for normal runs.
    cell_name   = ''
    // Optional cell index suffix for raw MATLAB-style input folder naming.
    cell_index  = -1
    // Published output directory for workflow products.
    output_dir  = './workflow/output'
    // Skip deskew and run only deconvolution from --decon_input_dir.
    decon_only  = false
    // Backward-compatible directory containing already deskewed TIFFs for decon_only runs.
    decon_input_dir = ''

    // Deskew voxel size in X/Y, in microns.
    dx          = -1
    // Deskew/decon voxel size in Z, in microns.
    dz          = -1
    // Deskew shear angle in degrees.
    angle       = 40
    // Deskew flip/orientation flag passed through to deskew code.
    flip        = 1

    // Constant background subtraction applied during PSF generation/handling.
    background  = -1
    // Richardson-Lucy iteration count for deconvolution.
    iter        = -1

    // Backward-compatible numerical aperture. Prefer detection_na.
    na          = -1
    // Detection objective numerical aperture.
    detection_na = -1
    // Illumination objective numerical aperture.
    illumination_na = -1
    // Emission wavelength in microns for PSF generation and CUDA deconvolution.
    wavelength  = -1
    // Immersion refractive index for PSF generation.
    ni          = -1
    // Specimen/sample refractive index.
    ns          = -1
    // Design immersion refractive index for vectorial PSF modeling.
    ni0         = -1
    // Coverslip thickness in microns for the actual optical path.
    tg          = -1
    // Design coverslip thickness in microns for vectorial PSF modeling.
    tg0         = -1
    // Coverslip refractive index for the actual optical path.
    ng          = -1
    // Design coverslip refractive index for vectorial PSF modeling.
    ng0         = -1
    // Design immersion thickness in microns for vectorial PSF modeling.
    ti0         = -1
    // Oversampling factor used when generating the theoretical PSF.
    oversample_factor = 3
    // Theoretical PSF model: vectorial, scalar, or gaussian.
    psf_model   = 'vectorial'
    // Seed PSF mode: single detection PSF or light-sheet effective PSF.
    psf_mode    = 'single'
    // Illumination PSF rotation angle for light-sheet effective PSF mode.
    light_sheet_angle = 90
    // Camera pixel size in microns; with magnification this can derive dxy.
    camera_pixel_size = -1
    // Objective/tube magnification; with camera_pixel_size this can derive dxy.
    magnification = -1
    // Final sample pixel size in X/Y, in microns, unless derived from camera settings.
    dxy         = -1
    // Number of Z planes in the generated theoretical PSF.
    psf_size_z  = 101
    // Generated theoretical PSF width/height in pixels.
    psf_size_xy = 61

    // MATLAB deconvblind iteration count for blind PSF estimation.
    blind_iters = -1
    // Blind PSF estimation XY tile size; <= 0 auto-sizes conservatively.
    chunk_xy    = -1
    // CUDA deconvolution core XY tile size; <= 0 auto-sizes from available VRAM.
    decon_chunk_xy = -1
    // XY halo per edge before MATLAB deconvblind.
    pad_xy      = 32
    // Z halo per edge before MATLAB deconvblind.
    pad_z       = 20
    // Python workers used to extract/prefetch blind PSF chunks.
    blind_workers = 72
    // Parallel MATLAB deconvblind processes for chunked blind estimation.
    matlab_workers = 24
    // CPU threads per MATLAB process; code clamps to one or two.
    matlab_threads = 1
    // MATLAB executable visible from the DECON task.
    matlab_bin = matlabBin
    // MATLAB root to bind into the deconvolution container.
    matlab_root = matlabRoot ?: ''
    // Per-MATLAB-call timeout in seconds; <= 0 disables the timeout.
    matlab_timeout = 1800
    // Number of Z slices used for blind PSF estimation; <= 0 uses full Z.
    blind_z_slices = 128
    // Upper bound for SNR-based PSF merge weighting to limit bright artifacts.
    snr_weight_cap = 100
    // Number of blind chunks to prefetch; <= 0 submits one worker batch at a time.
    prefetch_chunks = 0
    // Parallel CUDA deconvolution workers per process.
    decon_workers = -1
    // CUDA deconvolution XY overlap; <= 0 uses the pipeline default from PSF size.
    overlap_xy  = 0
    // Manual GPU memory budget in GB; -1 lets the code query available VRAM.
    vram_gb     = -1
    // Optional directory for reusable blind PSF cache entries.
    psf_cache_dir = ''
    // Disable PSF cache reads/writes even when psf_cache_dir is set.
    no_psf_cache = false
    // Build the decon conda environment before DECON.
    build_decon_container = true
}

profiles {
    // Default Slurm/conda profile for cluster execution.
    my_cluster {
        conda.enabled = true
    }

    // Light-sheet/ctASLM profile: run deskew first, then GPU deconvolution.
    light_sheet {
        conda.enabled = false
        params.decon_only = false
        params.angle = 40
        params.flip = 1
        params.psf_mode = 'light_sheet'
        params.light_sheet_angle = 90
    }

    // Wide-frame mode. Pass dataset-specific optical parameters on each run.
    wide_frame {
        conda.enabled = false
        params.psf_mode = 'single'
    }

    // Light-sheet deconvolution profile: input is already a 3-D TIFF stack, so skip deskew.
    light_sheet_decon {
        conda.enabled = false
        params.decon_only = true
        params.psf_mode = 'light_sheet'
        params.light_sheet_angle = 90
    }

    conda_runtime {
        conda.enabled = false
        params.build_decon_container = true
    }

}

process {
    // All cluster work is submitted through Slurm unless a profile overrides it.
    executor = 'slurm'

    // Deskew does not require a GPU.
    withName: DESKEW {
        cpus   = 4
        memory = '32 GB'
        queue  = 'super'
    }

    // Deconvolution runs on the GPU queue inside the conda runtime built by BUILD_DECON_CONTAINER.
    withName: DECON {
        queue          = 'GPU'          // Slurm partition/queue for GPU work.
        clusterOptions = '--gres=gpu:1' // Request one GPU from Slurm.
        cpus           = 72             // CPU cores reserved for Python/MATLAB helpers.
        memory         = '256 GB'       // RAM reserved for TIFF windows and PSF chunks.
    }

}
