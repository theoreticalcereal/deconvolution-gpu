params {
    // pathing defaults
    cell_index  = ''
    channels    = ''
    timepoints  = ''
    output_dir  = 'output'
    decon_only  = false
    decon_input_dir = ''

    // deskew defaults
    dx          = 0.118
    dz          = 0.118
    angle       = 40
    flip        = 1

    // deconvolution defaults
    background  = 0
    iter        = 10

    // default psf mode blind deconvolution
    no_blind    = false

    // Optical parameters
    na          = 1.0
    detection_na = ''
    illumination_na = ''
    wavelength  = 0.520    // µm
    ni          = 1.515
    ns          = ''
    ni0         = ''
    tg          = ''
    tg0         = ''
    ng          = ''
    ng0         = ''
    ti0         = ''
    oversample_factor = 3
    psf_model   = 'vectorial'
    camera_pixel_size = ''
    magnification = ''
    dxy         = 0.118     // µm
    psf_size_z  = 101
    psf_size_xy = 61

    // blind estimation tuning
    blind_iters = 10
    chunk_xy    = 256    // blind PSF XY tile; <= 0 auto-sizes, capped conservatively
    decon_chunk_xy = 0   // <= 0 auto-sizes CUDA decon chunks from available VRAM
    pad_xy      = 32     // XY halo per edge before deconvblind
    pad_z       = 20     // Z halo per edge before deconvblind
    blind_workers = 8    // chunk extraction/prefetch workers
    matlab_workers = 8   // MATLAB deconvblind processes; keep 1 on Slurm
    matlab_threads = 1   // per MATLAB process; code clamps to 1 or 2
    matlab_timeout = 1800 // per blind chunk; <= 0 disables timeout
    blind_z_slices = 128 // <= 0 uses full Z for blind PSF estimation
    snr_weight_cap = 100 // prevents bright artifacts from dominating PSF merge
    prefetch_chunks = 0  // <= 0 keeps one blind worker batch submitted
    decon_workers = 1
    overlap_xy  = 0      // <= 0 uses capped PSF/4 CUDA decon overlap
    vram_gb     = 0
    psf_cache_dir = ''
    no_psf_cache = false

    // PSF sanity-check mode
    psf_sanity_check = false
    psf_sanity_input_dir = ''
    psf_sanity_tiff_index = 0
    psf_sanity_xy = 512
}

profiles {
    my_cluster {
        conda.enabled = true
        conda.useMamba = true
    }

    docker {
        docker.enabled = true
    }

    psf_sanity {
        conda.enabled = true
        conda.useMamba = true

        params.psf_sanity_check = true
        params.blind_iters = 3
        params.blind_z_slices = 64
        params.psf_sanity_xy = 512
        params.blind_workers = 2
        params.matlab_workers = 1
        params.matlab_threads = 1
        params.prefetch_chunks = 2

        process {
            withName: PSF_SANITY_CHECK {
                cpus = 4
                memory = '32 GB'
                queue = 'super'
            }
        }
    }
}

process {
    executor = 'slurm'

    withName: DESKEW {
        cpus   = 4
        memory = '32 GB'
        queue  = 'super'
    }

    withName: DECON {
        conda          = "${projectDir}/environment.yml"
        cpus           = 8
        beforeScript   = '''
            module load mamba/2.3.0

            _nxf_real_conda="$(command -v conda || true)"
            _nxf_conda_base="$PWD/.nxf-conda-shim"

            mkdir -p "$_nxf_conda_base/bin"
            printf '%s\n' \
                '_nxf_env_prefix="${1:-}"' \
                'if [ -z "$_nxf_env_prefix" ] || [ ! -d "$_nxf_env_prefix/bin" ]; then' \
                '    echo "ERROR: Nextflow conda env prefix is missing or invalid: ${_nxf_env_prefix:-<empty>}" >&2' \
                '    return 1' \
                'fi' \
                'export CONDA_PREFIX="$_nxf_env_prefix"' \
                'export CONDA_DEFAULT_ENV="$(basename "$_nxf_env_prefix")"' \
                'export PATH="$_nxf_env_prefix/bin:${PATH:-}"' \
                'export LD_LIBRARY_PATH="$_nxf_env_prefix/lib:${LD_LIBRARY_PATH:-}"' \
                'export PYTHONNOUSERSITE=1' \
                'if [ -d "$_nxf_env_prefix/etc/conda/activate.d" ]; then' \
                '    for _nxf_hook in "$_nxf_env_prefix/etc/conda/activate.d"/*.sh; do' \
                '        [ -f "$_nxf_hook" ] && . "$_nxf_hook"' \
                '    done' \
                '    unset _nxf_hook' \
                'fi' \
                > "$_nxf_conda_base/bin/activate"

            conda() {
                if [ "${1:-}" = info ] && [ "${2:-}" = --json ]; then
                    printf '{\n  "conda_prefix": "%s"\n}\n' "$_nxf_conda_base"
                elif [ -n "$_nxf_real_conda" ]; then
                    "$_nxf_real_conda" "$@"
                else
                    echo "ERROR: conda command is not available" >&2
                    return 127
                fi
            }
        '''
        queue          = 'GPU'
        clusterOptions = '--gres=gpu:1'
        cpus           = 8
        memory         = '32 GB'
    }
}
