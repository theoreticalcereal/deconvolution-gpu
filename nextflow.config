params {
    // pathing defaults
    cell_index  = ''
    channels    = '0'
    timepoints  = '0'

    // deskew defaults
    dx          = 0.15
    dz          = 0.318
    angle       = 45
    flip        = 1

    // deconvolution defaults
    background  = 0
    iter        = 10

    // default psf mode blind deconvolution
    no_blind    = false

    // Optical parameters
    na          = 1.0
    wavelength  = 0.525    // µm
    ni          = 1.33
    dxy         = 0.15      // µm
    psf_size_z  = 61
    psf_size_xy = 128

    // blind estimation tuning
    blind_iters = 10
    chunk_xy    = 256
    pad_xy      = 32     // XY reflect-padding per edge before deconvblind
}

process {
    executor = 'slurm'

    withName: DESKEW {
        cpus   = 4
        memory = '32 GB'
        queue  = 'super'
    }

    withName: DECON {
        conda          = "${projectDir}/environment.yml"
        queue          = 'GPU'
        clusterOptions = '--gres=gpu:1'
        cpus           = 8
        memory         = '32 GB'
    }
}
