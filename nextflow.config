params {
    image_path  = '/work/bioinformatics/s249154/deconvolution-skeleton'
    cell_name   = '2026-05-18-vasculature'
    cell_index  = ''
    channels    = '0'
    timepoints  = '0'
    dx          = 0.15
    dz          = 0.318
    angle       = 45
    flip        = 1
    psf_path    = '/work/bioinformatics/s249154/deconvolution-skeleton/scripts'
    psf_file    = 'ctASLM2-510nm.tif'  
    background  = 0
    iter        = 10
    output_dir  = '/work/bioinformatics/s249154/deconvolution-skeleton/output'
}

process {
    executor = 'slurm'
    // DESKEW uses system MATLAB, so it runs with default settings
    withName: DESKEW {
        cpus = 4
        memory = '16 GB'
    }

    // STATIC_DECON gets the GPU and builds its own environment isolatedly
    withName: STATIC_DECON {
        conda = "conda-forge::pycudadecon=1.0.2 conda-forge::numpy conda-forge::tifffile python=3.10"
        clusterOptions = '--gres=gpu:1'
        cpus = 4
        memory = '32 GB'
    }
}